{
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/main.ts"
    },
    "socios": {
      "root": "socios-frontend",
      "framework": "vite",
      "rewrites": [
        { "source": "/app/(.*\\..+)", "destination": "/$1" },
        { "source": "/app(/.*)?", "destination": "/index.html" }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/app(/.*)?",
      "destination": {
        "type": "service",
        "service": "socios"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}
