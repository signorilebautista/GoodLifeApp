# Opción A: usar una connection string (Neon/Supabase/etc.)
DATABASE_URL=postgresql://usuario:password@host:5432/db?sslmode=require

# Opción B: usar variables sueltas (solo si no se define DATABASE_URL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=goodlife

PORT=3000

# Mail (SMTP) — requerido para enviar la contraseña temporal al crear un profesor
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_cuenta@gmail.com
SMTP_PASS=tu_app_password_de_google

# Web Push (notificaciones de vencimiento de cuota) — generar con:
#   npx web-push generate-vapid-keys
# Sin estas 3 variables el envío de push queda deshabilitado (no rompe el resto del backend).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu_cuenta@gmail.com
